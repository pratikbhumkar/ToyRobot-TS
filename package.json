{
  "name": "toyrobot-ts",
  "version": "1.0.0",
  "description": "A typescript version of ToyRobot.",
  "main": "index.ts",
  "scripts": {
    "test": "jest",
    "start": "npx tsc -p tsconfig.build.json && node ./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratikbhumkar/ToyRobot-TS.git"
  },
  "author": "Pratik Bhumkar",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9"
  },
  "bugs": {
    "url": "https://github.com/pratikbhumkar/ToyRobot-TS/issues"
  },
  "homepage": "https://github.com/pratikbhumkar/ToyRobot-TS#readme",
  "dependencies": {
    "typescript": "^6.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "node_modules/variables/.+\\.(j|t)sx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!variables/.*)"
    ]
  }
}
